# Copy to .env and fill in. All values are optional in fake mode.

# Anthropic API key (required when USE_FAKES=false and LLM_BACKEND=anthropic).
ANTHROPIC_API_KEY=

# Metadata store. SQLite for local dev; Postgres in production. A relative
# sqlite path is anchored to the project root (not the process CWD), so the API,
# worker, and any CLI run share one database regardless of where they start.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://repodify:repodify@localhost:5432/repodify

# Redis for the arq job queue.
REDIS_URL=redis://localhost:6379

# HTTP API auth. When set, every endpoint except /health requires
# `Authorization: Bearer <token>`. Leave blank to disable auth (local dev only).
API_TOKEN=

# Optional Podcast Index BYOK for name search (https://api.podcastindex.org/).
# Empty = iTunes Search API only (zero-config default).
# PODCASTINDEX_API_KEY=
# PODCASTINDEX_API_SECRET=
# Any non-empty value enables add/byfeedurl after a pasted RSS URL resolves.
# PODCASTINDEX_WRITE_KEY=
# ITUNES_COUNTRY=us
# SEARCH_MIN_CHARS=3

# Allowed CORS origins for a browser web UI / mobile app, as a JSON list.
# Default is ["*"] (permissive); restrict in production.
# CORS_ALLOW_ORIGINS=["https://app.example.com"]

# Where downloaded audio, transcripts, and outputs are written. A relative path
# is anchored to the project root (not the process CWD).
DATA_DIR=data

# Use in-memory/test fakes for STT, LLM, and TTS instead of real models.
# Set to false only on a GPU host with the [gpu] extra installed.
USE_FAKES=true

# Models
# LLM backend. "anthropic" (default) needs ANTHROPIC_API_KEY above; "ollama" uses
# a local Ollama server and needs no key; "openrouter" calls a hosted model on
# OpenRouter and reuses OPENROUTER_API_KEY / OPENROUTER_BASE_URL below. On ollama,
# MAP_MODEL/REDUCE_MODEL are ignored and OLLAMA_MODEL is used for both stages; on
# openrouter, OPENROUTER_LLM_MODEL is used for both stages. The backend and model
# can also be picked at runtime from the web Settings page (that choice overrides
# these defaults).
LLM_BACKEND=anthropic
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# TTS backend. "f5" (default) synthesizes locally on the GPU: F5-TTS for
# cloned/reference voices, Kokoro for stock catalog voices. "openrouter" calls a
# hosted TTS model on OpenRouter's OpenAI-compatible /audio/speech endpoint — no
# GPU required. A reference voice (narrator/host clip) is sent as the model's
# voice-clone reference; the mp3 result is transcoded to 24kHz mono WAV.
TTS_BACKEND=f5
# OPENROUTER_API_KEY=sk-or-...              # required when TTS_BACKEND=openrouter
# OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro
# OPENROUTER_LLM_MODEL=openai/gpt-4o-mini   # used when LLM_BACKEND=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# faster-whisper model size. "large-v3" is most accurate but needs ~10GB VRAM and
# won't fit alongside F5-TTS on an 8GB card; use "small" (or "base"/"medium") there.
WHISPER_MODEL=small
MAP_MODEL=claude-haiku-4-5-20251001
REDUCE_MODEL=claude-opus-4-8

# Spoken words per minute, used to size the ~30-min script.
WPM=130

# Bundled default narrator voice for F5-TTS (reference clip + its transcript).
# NARRATOR_REF_AUDIO=assets/narrator.wav
# NARRATOR_REF_TEXT=Hello and welcome to the show.

# Two-host mode (host_count=2): a stock reference clip + text per host.
# HOST_A_REF_AUDIO=assets/host_a.wav
# HOST_A_REF_TEXT=Hey everyone, great to be here.
# HOST_B_REF_AUDIO=assets/host_b.wav
# HOST_B_REF_TEXT=Absolutely, let us dig in.

# Stock (Kokoro catalog) voices: fallback voice for a detected speaker that is not
# cloned and has no explicit assignment. See GET /voices for the catalog.
# DEFAULT_STOCK_VOICE=af_heart

# Opt-in voice cloning (clone=true on a job). Cloned output is always labeled
# synthetic, carries a spoken disclaimer, and is watermarked.
# CLONE_DISCLAIMER=This episode was generated by AI. The voices are synthetic and are not the original hosts.
# HF_TOKEN=hf_...   # Hugging Face token, required by pyannote diarization in real mode
# PYANNOTEAI_API_KEY=   # hosted diarization (BYOK) via api.pyannote.ai
