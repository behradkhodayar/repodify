# Copy to .env and fill in. All values are optional in fake mode.

# Anthropic API key (required when USE_FAKES=false and LLM_BACKEND=anthropic).
ANTHROPIC_API_KEY=

# Metadata store. SQLite for local dev; Postgres in production.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/podcast_compactor

# Redis for the arq job queue.
REDIS_URL=redis://localhost:6379

# HTTP API auth. When set, every endpoint except /health requires
# `Authorization: Bearer <token>`. Leave blank to disable auth (local dev only).
API_TOKEN=

# Allowed CORS origins for a browser web UI / mobile app, as a JSON list.
# Default is ["*"] (permissive); restrict in production.
# CORS_ALLOW_ORIGINS=["https://app.example.com"]

# Where downloaded audio, transcripts, and outputs are written.
DATA_DIR=data

# Use in-memory/test fakes for STT, LLM, and TTS instead of real models.
# Set to false only on a GPU host with the [gpu] extra installed.
USE_FAKES=true

# Models
# LLM backend. "anthropic" (default) needs ANTHROPIC_API_KEY above; "ollama" uses
# a local Ollama server and needs no key. On ollama, MAP_MODEL/REDUCE_MODEL are
# ignored and OLLAMA_MODEL is used for both stages.
LLM_BACKEND=anthropic
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# faster-whisper model size. "large-v3" is most accurate but needs ~10GB VRAM and
# won't fit alongside F5-TTS on an 8GB card; use "small" (or "base"/"medium") there.
WHISPER_MODEL=small
MAP_MODEL=claude-haiku-4-5-20251001
REDUCE_MODEL=claude-opus-4-8

# Spoken words per minute, used to size the ~30-min script.
WPM=130

# Bundled default narrator voice for F5-TTS (reference clip + its transcript).
# NARRATOR_REF_AUDIO=assets/narrator.wav
# NARRATOR_REF_TEXT=Hello and welcome to the show.

# Two-host mode (host_count=2): a stock reference clip + text per host.
# HOST_A_REF_AUDIO=assets/host_a.wav
# HOST_A_REF_TEXT=Hey everyone, great to be here.
# HOST_B_REF_AUDIO=assets/host_b.wav
# HOST_B_REF_TEXT=Absolutely, let us dig in.

# Opt-in voice cloning (clone=true on a job). Cloned output is always labeled
# synthetic, carries a spoken disclaimer, and is watermarked.
# CLONE_DISCLAIMER=This episode was generated by AI. The voices are synthetic and are not the original hosts.
# HF_TOKEN=hf_...   # Hugging Face token, required by pyannote diarization in real mode
